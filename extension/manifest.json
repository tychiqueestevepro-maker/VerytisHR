{
  "manifest_version": 3,
  "name": "Verytis LinkedIn Sync",
  "version": "1.0.0",
  "description": "Synchronise votre session LinkedIn avec VerytisHR",
  "permissions": ["cookies", "activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://*.linkedin.com/*", 
    "http://localhost:3000/*", 
    "https://verytis-hr.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "http://localhost:3000/*", 
        "https://verytis-hr.vercel.app/*"
      ],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
